# Deployed PulseVault contract address
VITE_CONTRACT_ADDRESS=

# Optional: Pinata JWT for real IPFS uploads. Without it the dApp stores
# encrypted blobs in browser localStorage (local://) so the flow still works.
VITE_PINATA_JWT=

# Optional: custom IPFS gateway
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
